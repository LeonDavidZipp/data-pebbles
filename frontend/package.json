{
  "name": "data-pebbles-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env",
    "start": "nuxt start",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "openapi-generator generate -i ../openapi.json -g typescript-fetch -o ./app/utils/api --additional-properties=supportsES6=true,modelPropertyNaming=original && find ./app/utils/api -name '*.ts' -exec sed -i '' 's/let useForm = false/let useForm = canConsumeForm/g' {} +"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.95",
    "@iconify-json/simple-icons": "^1.2.72",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/i18n": "^10.2.3",
    "dompurify": "^3.3.3",
    "nuxt": "^4.3.1",
    "nuxt-lucide-icons": "^2.0.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^25.5.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.30.3"
}
